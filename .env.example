# Docker Compose settings (`docker compose --profile full up -d --build`).
# Copy to .env next to docker-compose.yml. .env is git-ignored; never commit it.

# Required: at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Change for anything other than a local machine.
POSTGRES_PASSWORD=queueforge

# Optional: when set (16+ chars), /metrics requires "Authorization: Bearer <token>".
METRICS_TOKEN=

LOG_LEVEL=info
WORKER_REPLICAS=2
WORKER_CONCURRENCY=5

# Host ports
FRONTEND_PORT=8080
API_PORT=4000
POSTGRES_PORT=5433

# Origin the browser uses for the dashboard (the API's CORS setting)
CORS_ORIGIN=http://localhost:8080
