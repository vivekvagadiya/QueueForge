PORT=4000
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://user:password@localhost:5432/queueforge
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=1h

# Redis Streams: job streams are named <STREAM_PREFIX>:queue:<queueId>:jobs
STREAM_PREFIX=queueforge

# Outbox publisher (npm run publisher)
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
# A claim older than this is treated as abandoned (publisher crashed) and re-claimed.
OUTBOX_CLAIM_TIMEOUT_MS=30000
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000

# Workers (npm run worker)
# WORKER_NAME=worker-1
CONSUMER_GROUP=queueforge-workers
# "*" = every non-archived queue, or comma-separated queue UUIDs
WORKER_QUEUES=*
WORKER_QUEUE_REFRESH_MS=10000
WORKER_CONCURRENCY=5
WORKER_BLOCK_MS=2000
WORKER_LEASE_MS=30000
# Lease is renewed while a handler runs; default WORKER_LEASE_MS / 3
# WORKER_LEASE_RENEW_MS=10000
WORKER_HEARTBEAT_MS=5000
# Stream entries pending this long in any consumer (e.g. a crashed worker) are taken over
WORKER_PENDING_IDLE_MS=60000
WORKER_PENDING_CHECK_MS=15000
WORKER_SHUTDOWN_GRACE_MS=20000
# How often a worker checks whether its running jobs were cancelled
WORKER_CANCEL_CHECK_MS=1000
# Backoff for retrying a claim rejected by the queue's concurrency limit
WORKER_CAPACITY_RETRY_BASE_MS=200
WORKER_CAPACITY_RETRY_MAX_MS=2000
# Retry backoff for failed job attempts (used by workers and the recovery process)
JOB_RETRY_BASE_MS=1000
JOB_RETRY_MAX_MS=300000

# Recovery process (npm run recovery): releases scheduled jobs and due retries,
# recovers expired leases, and runs retention
RECOVERY_INTERVAL_MS=1000
RECOVERY_BATCH_SIZE=100
WORKER_HEARTBEAT_TIMEOUT_MS=30000

# Retention (in the recovery process). Ages in ms; 0 = keep forever.
RETENTION_INTERVAL_MS=60000
RETENTION_BATCH_SIZE=1000
# COMPLETED jobs (attempts are deleted with their job)
JOB_RETENTION_COMPLETED_MS=604800000
# FAILED, DEAD and CANCELLED jobs
JOB_RETENTION_FAILED_MS=2592000000
# PUBLISHED outbox events
OUTBOX_RETENTION_MS=86400000
# Acknowledged stream entries; pending or undelivered entries are never trimmed
STREAM_RETENTION_MS=3600000
# Stream consumers with no pending entries, idle this long, are deleted
STREAM_CONSUMER_RETENTION_MS=86400000

# Observability
# Health/metrics server for the publisher, worker and recovery processes
# (GET /health/live, /health/ready, /metrics). Unset = disabled. Use a different
# port per process on the same host. The API serves these on PORT instead
# (/api/v1/health/live, /api/v1/health/ready, /metrics).
# OPS_PORT=9464
OPS_HOST=0.0.0.0
# When set, /metrics requires "Authorization: Bearer <token>" (min 16 chars)
# METRICS_TOKEN=
# Queue depth / waiting age / worker / outbox gauges are recomputed at most this often (API)
METRICS_CACHE_MS=5000
HEALTH_CHECK_TIMEOUT_MS=2000

# Optional: integration tests default to DATABASE_URL with the database name replaced by queueforge_test
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/queueforge_test
