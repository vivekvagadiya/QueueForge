{
  "name": "queueforge-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QueueForge control-plane API server",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "publisher": "node src/publisher.js",
    "dev:publisher": "node --watch src/publisher.js",
    "worker": "node src/worker.js",
    "dev:worker": "node --watch src/worker.js",
    "db:migrate": "node src/database/migrate.js up",
    "db:migrate:undo": "node src/database/migrate.js down",
    "db:migrate:undo:all": "node src/database/migrate.js down --to 0",
    "db:migrate:pending": "node src/database/migrate.js pending",
    "db:migrate:status": "node src/database/migrate.js executed",
    "test": "node --import ./test/setup.js --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.6.0",
    "sequelize": "^6.37.5",
    "umzug": "^3.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
